{
  "name": "selfsync-obsidian",
  "version": "0.10.3",
  "description": "English-first Obsidian plugin for self-hosted Selfsync",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "../scripts/build-wasm.sh",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "i18n:check": "node --import tsx test/i18n-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.6.0",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "fast-uri": "^3.1.9"
  }
}
